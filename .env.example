# Copie para ".env":  cp .env.example .env   (Windows: copy .env.example .env)

# Banco local SQLite. O arquivo é criado por "npm run db:push".
DATABASE_URL="file:./data/prospectar.db"

# Fonte padrão das buscas: "gosom" (motor gratuito em Docker) ou "places" (API oficial do Google, paga).
FONTE_PADRAO="gosom"

# Endereço do motor gosom (docker compose). Mude só se trocar a porta no docker-compose.yml.
MOTOR_URL="http://localhost:8080"

# Chave da Google Places API (New). Só é necessária com a fonte "places".
# Console: https://console.cloud.google.com/apis/library/places.googleapis.com
GOOGLE_PLACES_API_KEY=""

# Proxies para o motor gosom, separados por vírgula. Opcional; ajuda a evitar bloqueio do IP em buscas grandes.
# Formato: socks5://usuario:senha@host:porta,http://host2:porta2
PROXIES=""
